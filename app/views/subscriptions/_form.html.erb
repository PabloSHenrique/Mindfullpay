<%= form_with(model: subscription) do |f| %>
  
  <% if subscription.errors.any? %>
    <div class="alert alert-danger py-1 mb-2">
      <ul class="mb-0 small">
        <% subscription.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-2"> <!-- Mudou de mb-3 para mb-2 -->
    <%= f.label :name, "Nome da assinatura", class: "form-label small fw-semibold mb-1" %>
    <%= f.text_field :name, class: "form-control form-control-sm", placeholder: "Ex: Netflix" %>
  </div>

  <div class="mb-2"> <!-- Mudou de mb-3 para mb-2 -->
    <%= f.label :category, "Qual é a categoria?", class: "form-label small fw-semibold mb-1" %>
    <%= f.select :category,
      [
        ['Streaming', 'Streaming'], 
        ['Música', 'Music'],
        ['Educação', 'Education'],
        ['Leitura', 'Reading'],
        ['Saúde', 'Health'],
        ['Games', 'Games'],
        ['Outros', 'Outhers'] 
      ],
      { prompt: 'Selecione a categoria...' }, 
      { class: "form-select" } %>
  </div>

  <div class="mb-2"> <!-- Mudou de mb-3 para mb-2 -->
    <%= f.label :due_date, "Qual é o dia de vencimento?", class: "form-label small fw-semibold mb-1" %>
    <%= f.number_field :due_date, class: "form-control form-control-sm", placeholder: "Ex: 10" %>
  </div>

  <div class="mb-3"> <!-- Mudou de mb-4 para mb-3 -->
    <%= f.label :price, "Valor (R$):", class: "form-label small fw-semibold mb-1" %>
    <%= f.number_field :price, step: "0.01", class: "form-control form-control-sm", placeholder: "0.00" %>
  </div>

  <div class="d-grid">
    <%= f.submit "Salvar assinatura", class: "btn btn-primary btn-sm py-2" %>
  </div>

<% end %>