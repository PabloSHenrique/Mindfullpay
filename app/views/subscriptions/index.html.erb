<div class="container mt-4">
  
 
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">Minhas Assinaturas</h1>
    <%= link_to "Nova Assinatura", new_subscription_path, class: "btn btn-primary" %>
  </div>
  
  <div class="card shadow-sm border-0 rounded-4 mb-4 bg-light">
    <div class="card-body d-flex justify-content-between align-items-center py-3 px-4">
      <span class="text-muted fw-semibold">Gasto Mensal Total:</span>
      <!-- Exibe formatado em Reais (R$) -->
      <h4 class="mb-0 text-success fw-bold">
        <%= number_to_currency(@total_price, unit: "R$ ", separator: ",", delimiter: ".") %>
      </h4>
    </div>
  </div>
  
  <div class="row g-3 mb-4 align-items-center">
    <div class="col-md-8">
      <input type="text" id="searchSubscription" class="form-control form-control-lg" placeholder="Pesquisar assinatura (ex: Netflix, Spotify)...">
    </div>
    <div class="col-md-4 text-md-end">
      <button id="toggleAllBtn" class="btn btn-outline-secondary w-100 w-md-auto">
        <i class="bi bi-eye-slash"></i> Ocultar Todos
      </button>
    </div>
  </div>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="subscriptionsGrid">
    <% @subscriptions.each do |subscription| %>
      <div class="col subscription-card-item" data-name="<%= subscription.name.downcase %>" data-category="<%= subscription.category.downcase %>">
        <div class="card h-100 shadow-sm border-0 rounded-4">
          <div class="card-body d-flex flex-column justify-content-between p-4">
            
            <div>
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title fw-bold text-dark mb-0"><%= subscription.name %></h5>
                <span class="badge bg-secondary"><%= subscription.category %></span>
              </div>

              <hr>

              <p class="card-text mb-2 text-muted">
                <strong>Vencimento:</strong> Dia <%= subscription.due_date %>
              </p>
              <p class="card-text mb-3">
                <strong>Valor mensal:</strong> <span class="text-success fw-bold fs-5">R$ <%= number_to_currency(subscription.price, unit: "", separator: ",", delimiter: ".") %></span>
              </p>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
              <%= link_to "Editar", edit_subscription_path(subscription), class: "btn btn-outline-primary btn-sm" %>
              <%= button_to "Deletar", subscription_path(subscription), method: :delete, data: { turbo_confirm: "Tem certeza que deseja apagar?" }, class: "btn btn-outline-danger btn-sm" %>
            </div>

          </div>
        </div>
      </div>
    <% end %>
  </div>

</div>


<script>
  document.addEventListener("turbo:load", () => {
    const searchInput = document.getElementById("searchSubscription");
    const toggleBtn = document.getElementById("toggleAllBtn");
    const cards = document.querySelectorAll(".subscription-card-item");
    let isHidden = false;

   
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const term = e.target.value.toLowerCase();
        cards.forEach(card => {
          const name = card.getAttribute("data-name");
          const category = card.getAttribute("data-category");
          if (name.includes(term) || category.includes(term)) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      });
    }

    
    if (toggleBtn) {
      toggleBtn.addEventListener("click", () => {
        isHidden = !isHidden;
        cards.forEach(card => {
          card.style.display = isHidden ? "none" : "";
        });
        toggleBtn.textContent = isHidden ? "Mostrar Todos" : "Ocultar Todos";
        toggleBtn.classList.toggle("btn-outline-secondary", !isHidden);
        toggleBtn.classList.toggle("btn-secondary", isHidden);
      });
    }
  });
</script>
