<div class="container mt-4 mb-3">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">

      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-3 p-md-4">
          
          <h3 class="card-title text-center mb-3 fw-bold text-dark">Editar Assinatura</h3>

          <!-- Renderiza o mesmo formulário compartilhado, passando a assinatura atual -->
          <%= render 'form', subscription: @subscription %>

          <div class="text-center mt-3">
            <%= link_to "Voltar", subscriptions_path, class: "text-decoration-none text-muted small" %>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>